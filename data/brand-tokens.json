{
  "version": "1.0",
  "principles": {
    "brand": "Ancient in spirit. Contemporary in execution.",
    "editorial": "Reading before decoration.",
    "gold": "Accent only, never a long-form reading background."
  },
  "colors": {
    "background": "#FBFAF7",
    "articleBackground": "#FFFFFF",
    "surface": "#FFFFFF",
    "text": "#211D18",
    "muted": "#74695E",
    "gold": "#A66B16",
    "goldDeep": "#81500F",
    "footer": "#F3EFE8",
    "line": "rgba(33,29,24,0.12)"
  },
  "typography": {
    "displayFamily": "Georgia, serif",
    "uiFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "homepageHero": "clamp(3.25rem, 6.5vw, 6rem)",
    "pageHero": "clamp(2.75rem, 5vw, 4.65rem)",
    "researchTitle": "clamp(2.5rem, 4vw, 3.65rem)",
    "articleH2": "clamp(1.8rem, 3vw, 2.35rem)",
    "bodyLineHeight": 1.78
  },
  "layout": {
    "shell": 1120,
    "maxWide": 1180,
    "articleWrapper": 920,
    "readingColumn": 760,
    "desktopGutter": 24,
    "mobileGutter": 14
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    80,
    96
  ],
  "radius": {
    "ui": 10,
    "card": 20,
    "image": 18,
    "pill": 999
  },
  "breakpoints": {
    "mobile": 640,
    "tablet": 960,
    "wide": 1500
  },
  "social": {
    "youtube": "https://www.youtube.com/@rudranaada",
    "instagram": "https://www.instagram.com/rudranaadamusic/",
    "x": "https://x.com/rudranaada"
  },
  "author": {
    "name": "Pratap Sharma",
    "path": "/authors/pratap"
  },
  "editorial": {
    "longFormRequired": [
      "direct-answer opening",
      "in brief",
      "key takeaways",
      "descriptive headings",
      "visual breaks",
      "internal links",
      "faq",
      "research references",
      "author attribution"
    ],
    "distinguish": [
      "primary text",
      "traditional commentary",
      "later retelling",
      "regional tradition",
      "popular belief",
      "scholarly interpretation",
      "RudraNāda artistic interpretation"
    ],
    "prohibited": [
      "invented Sanskrit",
      "invented verses",
      "generic SEO filler",
      "AI-sounding spirituality",
      "unlabelled artistic paraphrase presented as scripture"
    ]
  }
}